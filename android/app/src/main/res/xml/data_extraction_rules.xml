<?xml version="1.0" encoding="utf-8"?>
<!-- PRD §13: no Android cloud backup or device transfer. A database restored
     without its matching Keystore-protected PIN would break the app lock; the
     app's own backup files are the supported way to move to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
